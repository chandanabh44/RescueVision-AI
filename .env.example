# RescueVision AI - Environment Configuration Example
# Copy this file to .env for local development or set these variables in the Render Dashboard.
# NEVER commit real .env files with secrets into Git!

# Flask Core
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-in-production
# Set DEBUG=False in production!
DEBUG=False

# Database Configuration:
# - SQLite (Default): sqlite:///instance/rescuevision.db
#   IMPORTANT RENDER WARNING: Free-tier Web Services on Render have ephemeral (temporary) filesystems.
#   Any SQLite database or uploaded file will be erased on dyno restart or redeploy unless a Persistent Disk
#   is attached or an external database (such as Render PostgreSQL) is used.
# - Render PostgreSQL (Recommended for persistent production data):
#   Set DATABASE_URL to your Render PostgreSQL Internal Connection String, e.g.:
#   DATABASE_URL=postgresql://user:password@dpg-xxxxxx-a.render.com/rescuevision_db
DATABASE_URL=sqlite:///instance/rescuevision.db

# Server Configuration (Render automatically injects PORT)
HOST=0.0.0.0
PORT=5000

# Administrative Credentials (Change these in production!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-admin-password-2026

# AI / LLM Configuration
# Options: demo_fallback, gemini, openai, anthropic
AI_PROVIDER=demo_fallback
# Gemini API Key (get from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=
# OpenAI API Key (optional)
OPENAI_API_KEY=
# Anthropic API Key (optional)
ANTHROPIC_API_KEY=

# Disaster Data Source Polling Intervals & Flags
ENABLE_USGS_EARTHQUAKES=True
ENABLE_OPEN_METEO_FLOODS=True
ENABLE_NASA_EONET=True
ALERT_CACHE_HOURS=2

# Upload Security Limits
MAX_CONTENT_LENGTH_MB=10
ALLOWED_EXTENSIONS=png,jpg,jpeg,webp
UPLOAD_FOLDER=uploads


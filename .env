# RescueVision AI - Local Development Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=dev-secret-rescuevision-hackathon-2026-key
DEBUG=True

DATABASE_URL=sqlite:///instance/rescuevision.db
HOST=127.0.0.1
PORT=5000

ADMIN_USERNAME=admin
ADMIN_PASSWORD=RescueAdmin2026!

# LLM Fallback mode (does not require external API key)
AI_PROVIDER=demo_fallback
GEMINI_API_KEY=
OPENAI_API_KEY=

ENABLE_USGS_EARTHQUAKES=True
ENABLE_OPEN_METEO_FLOODS=True
ENABLE_NASA_EONET=True
ALERT_CACHE_HOURS=2

MAX_CONTENT_LENGTH_MB=10
ALLOWED_EXTENSIONS=png,jpg,jpeg,webp
UPLOAD_FOLDER=uploads
